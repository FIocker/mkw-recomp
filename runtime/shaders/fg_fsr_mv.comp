// FSR frame generation's dense motion (runtime/gfx/vk/device/vk_framegen.c). The native three-level flow is one vector
// per 16x16 pixels from the current picture to the previous one (previous = current - flow). FSR wants the opposite
// direction, previous - current. The search also sees the render jitter, so its delta is removed before the sign flip.
//
// A camera vector alone moves the player's kart and driver like the road. This pass tries the native vector of the
// pixel's flow cell and its eight neighbours. A candidate must match the two pictures better than the camera by a
// margin, belong to a supported vector cluster, and agree with the current depth. The camera remains the fallback at
// disocclusions and road edges. A still candidate is also tried, which keeps the HUD and a camera-following kart still.
// This uses this repository's own fg_flow.comp and fg_synth.comp; the confidence gates are new.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D cur_col;
layout(binding = 1) uniform sampler2D prev_col;
layout(binding = 2) uniform sampler2D depth_tex;   // R32F, 0 near and 1 far
layout(binding = 3) uniform sampler2D camera_mv;   // RG16F, previous - current, in render pixels
layout(binding = 4) uniform sampler2D native_flow; // RG16F, current - previous, in render pixels, one per 16x16
layout(binding = 5, rg16f) uniform writeonly image2D out_mv;

layout(push_constant) uniform Params {
    vec2 render_size;
    vec2 output_size;
    vec2 flow_size;      // output-resolution blocks, one vector per 16x16
    vec2 jitter_delta;   // this frame's render jitter - the last frame's, in render pixels
} p;

float luma(vec3 c) { return dot(min(c, vec3(4.0)), vec3(0.299, 0.587, 0.114)); }

bool inside(ivec2 q, ivec2 m) { return all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, m)); }

ivec2 output_pixel(ivec2 render_px) {
    vec2 q = (vec2(render_px) + vec2(0.5)) * p.output_size / p.render_size;
    return clamp(ivec2(floor(q)), ivec2(0), ivec2(p.output_size) - 1);
}

float match_error(ivec2 px, vec2 mv, ivec2 image_size) {
    ivec2 q = ivec2(round(vec2(px) + mv));
    float e = 0.0;
    const ivec2 tap[3] = ivec2[3](ivec2(0), ivec2(-2, 0), ivec2(2, 0));
    for (int i = 0; i < 3; i++) {
        ivec2 pc = output_pixel(clamp(px + tap[i], ivec2(0), image_size - 1));
        if (!inside(q + tap[i], image_size)) return 2.0;
        ivec2 qc = output_pixel(q + tap[i]);
        e += abs(luma(texelFetch(cur_col, pc, 0).rgb) - luma(texelFetch(prev_col, qc, 0).rgb));
    }
    return e / 3.0;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 image_size = ivec2(p.render_size);
    ivec2 flow_size = ivec2(p.flow_size);
    vec2 to_render = p.render_size / p.output_size;
    if (!inside(px, image_size)) return;

    vec2 camera = texelFetch(camera_mv, px, 0).xy;
    float camera_error = match_error(px, camera, image_size);
    float depth = texelFetch(depth_tex, px, 0).r;
    ivec2 block = px / 16;
    // The 5x5 cells include the three-by-three support neighbourhood of every candidate tried below.
    vec2 cell[25];
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            ivec2 b = clamp(block + ivec2(x, y), ivec2(0), flow_size - 1);
            cell[(y + 2) * 5 + x + 2] = texelFetch(native_flow, b, 0).xy;
        }
    }
    vec2 central_flow = cell[12];
    vec2 central_render = central_flow * to_render;
    int central_support = 0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++)
            central_support += distance(cell[(y + 2) * 5 + x + 2] * to_render, central_render) < 3.0 ? 1 : 0;

    float best_error = camera_error - 0.006;  // road and flat areas keep the per-pixel camera vector
    vec2 best = camera;
    bool us = false;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 b = clamp(block + ivec2(x, y), ivec2(0), flow_size - 1);
            vec2 native = cell[(y + 2) * 5 + x + 2];
            if (any(greaterThan(abs(native), vec2(256.0)))) continue;
            ivec2 bc = clamp(ivec2(floor((vec2(b * 16 + 8) + 0.5) * to_render)), ivec2(0), image_size - 1);
            float bd = texelFetch(depth_tex, bc, 0).r;
            // The flow cell's centre must describe the same surface as this pixel; the increasing tolerance follows
            // the nonlinear depth buffer into the distance.
            if (abs(bd - depth) > 0.015 + 0.025 * depth) continue;
            vec2 native_render = native * to_render;
            vec2 mv = -native_render + p.jitter_delta;
            float e = match_error(px, mv, image_size);
            // A one-cell output that disagrees with its neighbours is a repeated or smeared texture, not object motion.
            int s = 0;
            for (int sy = -1; sy <= 1; sy++)
                for (int sx = -1; sx <= 1; sx++)
                    s += distance(cell[(y + sy + 2) * 5 + x + sx + 2] * to_render, native_render) < 3.0 ? 1 : 0;
            if (s < 2 || e > 0.12) continue;
            float score = e - 0.0015 * float(s) + 0.0002 * float(abs(x) + abs(y));
            if (score < best_error) {
                best_error = score;
                best = mv;
                us = true;
            }
        }
    }

    // A reliable still match covers the HUD and the camera-following player's kart. A supported native zero vector can
    // settle an otherwise flat region; away from that vector the picture still needs the full margin, so repeated road
    // texture cannot turn the whole road still.
    float still_error = match_error(px, vec2(0.0), image_size);
    bool native_still = dot(central_render, central_render) < 2.25 && central_support >= 2;
    bool still_wins = still_error < camera_error - 0.010 || (native_still && still_error <= camera_error + 0.004);
    if (still_wins && still_error < 0.12 && (still_error < best_error || native_still)) {
        best = vec2(0.0);
        best_error = still_error;
        us = true;
    }

    if (!us) best = camera;
    imageStore(out_mv, px, vec4(best, 0.0, 0.0));
}
